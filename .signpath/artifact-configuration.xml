<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="riftengine-host.exe" product-name="RiftEngine" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="riftengine_dll.dll" product-name="RiftEngine" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
